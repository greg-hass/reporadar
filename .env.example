# ── Storage mode ────────────────────────────────────────────────────────────
# postgres = durable hourly history (the default when POSTGRES_URL is set).
# lite = zero-config JSON storage; no Postgres or token is required.
REPORADAR_MODE=postgres

# ── GitHub (optional in lite mode) ──────────────────────────────────────────
# A token gives the server a 5,000 req/hr budget instead of anonymous limits.
# Create at https://github.com/settings/tokens (classic) — no scopes needed for public search.
GITHUB_SERVER_TOKEN=ghp_your_token_here

# ── Postgres (defaults match docker-compose) ───────────────────────────────
# Only change these if you want to customize the DB container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reporadar

# ── Optional ───────────────────────────────────────────────────────────────
# JSON data directory used by lite mode. Default: ./data.
REPORADAR_DATA_DIR=./data
# Cron schedule for the star-tracking job (5-field cron). Default: hourly.
CRON_SCHEDULE=0 * * * *
# Host port to expose the app on.
PORT=3000
